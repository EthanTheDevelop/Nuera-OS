# -----------------------------------------------------------------------------
# Nuera OS — variables d'environnement
# Copier ce fichier en `.env` puis renseigner les valeurs.
# `.env` est ignoré par Git : n'y mettez jamais de valeur de production
# dans un fichier versionné, et ne partagez jamais ce fichier.
# -----------------------------------------------------------------------------

# --- Base de données ----------------------------------------------------------
# Mot de passe du PostgreSQL local lancé par `docker compose` (dev uniquement).
POSTGRES_PASSWORD=change-me-local-only
# Doit reprendre le mot de passe ci-dessus en local.
DATABASE_URL=postgres://nuera:change-me-local-only@127.0.0.1:5432/nuera_os
# Taille maximale du pool de connexions (optionnel, défaut : 10).
# DATABASE_POOL_MAX=10
# Appliquer les migrations au démarrage du serveur (`true` sur Coolify, voir
# docs/deployment-coolify.md ; laisser à false en local et utiliser `npm run db:migrate`).
DB_MIGRATE_ON_START=false

# --- Authentification (better-auth) ------------------------------------------
# Secret de signature (32 caractères minimum). À générer, par exemple :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL publique de l'application (sert aussi d'origine de confiance).
# Sur Coolify : le domaine HTTPS exact de l'application (ex. https://os.nuera.studio).
BETTER_AUTH_URL=http://localhost:3000

# --- Journalisation -----------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Stockage des fichiers (facultatif) ---------------------------------------
# Dossier des documents déposés : un volume persistant en production. Sans lui, le dépôt et le
# téléchargement répondent « connexion requise ». Jamais servi statiquement.
STORAGE_DIR=.data/storage
# Taille maximale d'un fichier déposé, en Mo (optionnel, défaut : 50).
# STORAGE_MAX_UPLOAD_MB=50

# --- CRM Twenty (facultatif) --------------------------------------------------
# Sans ces variables, l'intégration CRM répond « connexion requise ».
# En local, `npm run twenty:bootstrap` les renseigne dans `.env`.
# URL de l'instance, sans chemin (ex. https://crm.exemple.fr).
TWENTY_API_URL=
# Clé d'API Twenty (Paramètres → API & Webhooks). Secret.
TWENTY_API_KEY=
# Secret de signature des webhooks, 32 caractères minimum, identique à celui du webhook Twenty. Secret.
TWENTY_WEBHOOK_SECRET=
# Interface de la base (Adminer), lien « Base de données » réservé aux associés.
DB_ADMIN_URL=

# --- Coolify (facultatif) -----------------------------------------------------
# Sans ces variables, les sites répondent « connexion requise ».
# URL de l'instance, sans chemin (ex. https://coolify.exemple.fr).
COOLIFY_API_URL=
# Jeton d'API (Keys & Tokens). Droits `read` et `deploy` pour déclencher un déploiement. Secret.
COOLIFY_API_TOKEN=
# Secret du webhook, à ajouter à l'URL du canal Coolify : /api/webhooks/coolify?token=… Secret.
COOLIFY_WEBHOOK_SECRET=

# --- Uptime Kuma (facultatif) -------------------------------------------------
# URL de l'instance, sans chemin. Seules les sondes d'une page de statut publiée sont lues.
UPTIME_KUMA_URL=
# Identifiant (slug) de la page de statut publiée.
UPTIME_KUMA_STATUS_SLUG=
# Secret envoyé par la notification webhook de Kuma (en-tête x-nuera-webhook-token). Secret.
UPTIME_KUMA_WEBHOOK_SECRET=
# --- Signature DocuSeal (facultatif) ------------------------------------------
# Sans ces variables, l'écran Devis affiche « connexion requise » et propose la saisie manuelle.
# URL de l'API : https://api.docuseal.com, https://api.docuseal.eu ou celle de l'instance hébergée.
DOCUSEAL_API_URL=
# Clé d'API de la console DocuSeal. Secret.
DOCUSEAL_API_KEY=
# Secret whsec_… de l'onglet HMAC du webhook. URL à déclarer : /api/webhooks/docuseal. Secret.
DOCUSEAL_WEBHOOK_SECRET=
# --- Réponses suggérées, API OpenAI (facultatif) ------------------------------
# Sans clé ni modèle, le panneau de suggestion affiche « connexion requise ». Secret.
OPENAI_API_KEY=
# Identifiant du modèle, à choisir dans la documentation OpenAI (aucune valeur par défaut).
OPENAI_MODEL=
# Facultatif : autre point d'accès compatible. Défaut : https://api.openai.com/v1
OPENAI_BASE_URL=
# --- Rendez-vous, webhook Cal.diy / Cal.com (facultatif) ----------------------
# Sans ce secret, /api/webhooks/cal répond 404. 16 caractères minimum. Secret.
CAL_WEBHOOK_SECRET=
# --- Tâches planifiées (facultatif) -------------------------------------------
# Sans ce secret, /api/jobs/* répond 404. 32 caractères minimum. Voir docs/ops/jobs.md. Secret.
JOBS_SECRET=
# --- E-mails sortants, SMTP (facultatif) --------------------------------------
# Sans hôte ni expéditeur, rien ne part : la boîte d'envoi passe en « non configurée ».
SMTP_HOST=
# Par défaut 587 (STARTTLS exigé), ou 465 si SMTP_SECURE=true.
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
# Secret.
SMTP_PASSWORD=
# Expéditeur, par exemple « Nuera Studio <bonjour@exemple.fr> ».
SMTP_FROM=
# --- n8n (facultatif) ---------------------------------------------------------
# URL de production du nœud Webhook.
N8N_WEBHOOK_URL=
# Signature HMAC des deux sens, et /api/webhooks/n8n répond 404 sans elle. 32 caractères. Secret.
N8N_WEBHOOK_SECRET=
# Valeur de l'en-tête x-nuera-token, pour l'option Header Auth du nœud Webhook. Secret.
N8N_WEBHOOK_HEADER_TOKEN=
# Instance Twenty locale de développement (docker-compose.twenty.yml) :
# TWENTY_DB_PASSWORD=
# TWENTY_APP_SECRET=
# Écrit par `npm run twenty:bootstrap` pour le compte local dev@nuera.local :
# TWENTY_DEV_ADMIN_PASSWORD=

# --- Jeu de données STAGING (facultatif) --------------------------------------
# `npm run db:seed:staging` / `node cli/db-seed-staging.mjs` : refusé sauf si cette variable vaut
# exactement `true` ET si DATABASE_URL vise la base `nuera_os_staging`. Ne jamais la définir en
# production. Voir docs/ops/donnees-staging.md.
# SEED_ALLOWED=true
