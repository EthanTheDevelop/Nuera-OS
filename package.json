{
  "name": "nuera-os",
  "version": "0.1.0",
  "private": true,
  "description": "Nuera OS — plateforme interne de pilotage de l'agence Nuera Studio",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "vitest run --mode live",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-seed.ts",
    "db:studio": "drizzle-kit studio",
    "user:create": "tsx --conditions=react-server --env-file-if-exists=.env scripts/user-create.ts",
    "twenty:bootstrap": "tsx --conditions=react-server --env-file-if-exists=.env scripts/twenty-bootstrap.ts"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "better-auth": "1.7.11",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "motion": "14.4.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
